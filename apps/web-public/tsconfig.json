{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@kuberone/shared-theme": ["../../packages/shared-theme/src/index.ts"],
      "@kuberone/shared-theme/*": ["../../packages/shared-theme/src/*"],
      "@kuberone/shared-utils": ["../../packages/shared-utils/src/index.ts"],
      "@kuberone/shared-utils/*": ["../../packages/shared-utils/src/*"]
    }
  },
  "include": ["src"]
}
