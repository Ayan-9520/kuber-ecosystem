{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd ../.. && corepack enable && pnpm install --frozen-lockfile --ignore-scripts",
  "buildCommand": "cd ../.. && pnpm --filter @kuberone/shared-types --filter @kuberone/shared-theme --filter @kuberone/shared-validation --filter @kuberone/shared-utils run build && pnpm --filter @kuberone/mobile-dsa run build:docker",
  "outputDirectory": "dist",
  "framework": null,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://frozen-pour-memo-person.trycloudflare.com/api/:path*"
    },
    {
      "source": "/health/:path*",
      "destination": "https://frozen-pour-memo-person.trycloudflare.com/health/:path*"
    },
    {
      "source": "/((?!_expo|assets|favicon|icon|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
