{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "echo 'Using prebuilt partner dist (Expo export is too heavy for Vercel CI)'",
  "buildCommand": "echo 'Prebuilt dist — baked API: https://medline-julian-purse-lets.trycloudflare.com'",
  "outputDirectory": "dist",
  "framework": null,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://medline-julian-purse-lets.trycloudflare.com/api/:path*"
    },
    {
      "source": "/health",
      "destination": "https://medline-julian-purse-lets.trycloudflare.com/health/live"
    },
    {
      "source": "/health/:path*",
      "destination": "https://medline-julian-purse-lets.trycloudflare.com/health/:path*"
    },
    {
      "source": "/((?!_expo|assets|favicon|icon|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
