{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "echo 'Using prebuilt admin dist'",
  "buildCommand": "echo 'Prebuilt — API https://shows-like-gibson-shaw.trycloudflare.com'",
  "outputDirectory": "dist",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://shows-like-gibson-shaw.trycloudflare.com/api/:path*"
    },
    {
      "source": "/health",
      "destination": "https://shows-like-gibson-shaw.trycloudflare.com/health/live"
    },
    {
      "source": "/health/:path*",
      "destination": "https://shows-like-gibson-shaw.trycloudflare.com/health/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
