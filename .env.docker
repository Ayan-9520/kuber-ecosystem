# Committed Docker defaults — loaded into containers via docker-compose env_file.
# For host-side overrides, copy to .env (gitignored):  cp .env.docker .env

NODE_ENV=development
APP_ENV=development
API_PORT=4000
API_BASE_URL=http://localhost:4000
API_VERSION=v1
DATABASE_URL=mysql://root@mysql:3306/kuberone_dev
DATABASE_CONNECTION_LIMIT=10
MYSQL_DATABASE=kuberone_dev
REDIS_URL=redis://redis:6379
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
DATA_ENCRYPTION_KEY=change-me-field-encryption-key-min-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
CORS_ORIGINS=http://localhost:8080,http://localhost:5173,http://localhost:5174,http://localhost:8081,http://localhost:8082,http://localhost:5175,http://127.0.0.1:5175,https://kuberone.online,https://www.kuberone.online,https://partner.kuberone.online,https://kuberfinserve.com,https://www.kuberfinserve.com
# Shared secret for website → Admin dual-write (must match kuberfinserve KUBERONE_API_KEY)
WEBSITE_INTAKE_API_KEY=kuber-website-intake-local-key
PUBLIC_PROFILE_BASE_URL=https://pro.kuberone.online
VITE_API_BASE_URL=/api/v1
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=kuberone-dev-documents
# Local fallback when AWS keys are empty (must match docker volume mount)
DOCUMENT_STORAGE_PATH=/app/apps/backend/storage/documents
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_PROVIDER=openai
DEPLOYMENT_ROLLOUT_PHASE=staged
DOCKER_RUN_MIGRATIONS=true
DOCKER_SEED_ON_START=true
API_WORKERS_ENABLED=false
AUTOMATION_WORKER_ENABLED=true
CONTENT_WORKER_ENABLED=true
BACKUP_WORKER_ENABLED=false
DOCKER_NGINX_PORT=8080
DOCKER_API_PORT=4000
DOCKER_ADMIN_PORT=5173
DOCKER_WEB_PUBLIC_PORT=5174
DOCKER_MOBILE_CUSTOMER_PORT=8081
DOCKER_MOBILE_DSA_PORT=8082
DOCKER_MYSQL_PORT=3307
DOCKER_REDIS_PORT=6380
COMPOSE_PARALLEL_LIMIT=1

# Email OTP (Hostinger SMTP — same mailbox as website)
NOTIFICATION_EMAIL_ENABLED=true
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=loanleads@kuberfinserve.com
SMTP_PASS=Loanleads@123
EMAIL_FROM=loanleads@kuberfinserve.com
EMAIL_FROM_NAME=KuberOne

# Sync partner approve/reject back to Hostinger MySQL
KUBERFINSERVE_PARTNER_SYNC_URL=https://kuberfinserve.com/api/partner-status-sync.php

# SMS OTP — purchase gateway later (MSG91 / Twilio). Until then email + dev OTP 123456.
NOTIFICATION_SMS_ENABLED=true
SMS_PROVIDER=mock
