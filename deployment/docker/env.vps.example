# Copy to .env.vps on the VPS (never commit real secrets):
#   cp deployment/docker/env.vps.example deployment/docker/.env.vps

# --- Domain ---
API_DOMAIN=api.kuberone.online
API_BASE_URL=https://api.kuberone.online

# --- MySQL (generate strong passwords) ---
MYSQL_DATABASE=kuberone
MYSQL_USER=kuberone
MYSQL_PASSWORD=CHANGE_ME_mysql_app_password_32chars
MYSQL_ROOT_PASSWORD=CHANGE_ME_mysql_root_password_32chars

# --- Redis ---
REDIS_PASSWORD=CHANGE_ME_redis_password_32chars

# --- Auth / encryption (each min 32 random chars) ---
JWT_ACCESS_SECRET=CHANGE_ME_jwt_access_secret_min_32_chars__
JWT_REFRESH_SECRET=CHANGE_ME_jwt_refresh_secret_min_32_chars_
DATA_ENCRYPTION_KEY=CHANGE_ME_field_encryption_key_min_32____

# --- CORS (Vercel + website) ---
CORS_ORIGINS=https://kuberone.online,https://www.kuberone.online,https://partner.kuberone.online,https://customer.kuberone.online,https://pro.kuberone.online,https://kuberfinserve.com,https://www.kuberfinserve.com

# Must match Hostinger public_html/api/config.php → kuberone_api_key
WEBSITE_INTAKE_API_KEY=CHANGE_ME_website_intake_key_16plus

PUBLIC_PROFILE_BASE_URL=https://pro.kuberone.online

# First boot only — set true once, then false
DOCKER_SEED_ON_START=false

# --- Email (Hostinger SMTP) ---
NOTIFICATION_EMAIL_ENABLED=true
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=loanleads@kuberfinserve.com
SMTP_PASS=
EMAIL_FROM=loanleads@kuberfinserve.com
EMAIL_FROM_NAME=KuberOne

# --- SMS OTP (MSG91 Flow + DLT) ---
# 1) Create MSG91 account → enable Flow OTP template (DLT approved in India)
# 2) Put Auth Key + Flow Template ID below
# 3) Restart: docker compose ... up -d --build backend worker
# Until these are set, partner OTP still works via email SMTP above.
NOTIFICATION_SMS_ENABLED=true
SMS_PROVIDER=msg91
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=KUBERF

# Partner status sync back to website
KUBERFINSERVE_PARTNER_SYNC_URL=https://kuberfinserve.com/api/partner-status-sync.php

# Optional AI / S3
OPENAI_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
DEPLOYMENT_ROLLOUT_PHASE=staged
